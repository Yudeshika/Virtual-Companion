{
  "name": "virtual-companion",
  "version": "0.1.0",
  "private": true,
  "description": "A 3D desktop cat that triages your notifications with an LLM and only bugs you when it matters.",
  "type": "module",
  "scripts": {
    "build": "npm run build:extension && npm run build:relay",
    "build:extension": "node scripts/build-extension.mjs",
    "build:relay": "esbuild relay/src/server.ts --bundle --platform=node --format=esm --packages=external --outfile=relay/dist/server.js",
    "dev:relay": "tsx watch relay/src/server.ts",
    "start:relay": "node relay/dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "three": "^0.169.0",
    "twilio": "^5.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.0",
    "@types/supertest": "^6.0.2",
    "@types/three": "^0.169.0",
    "esbuild": "^0.24.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
