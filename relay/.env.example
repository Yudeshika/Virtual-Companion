# Copy to relay/.env (never commit .env)

# From https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# Shared secret the extension sends as x-relay-secret.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RELAY_READ_SECRET=your_random_secret_here

# The public URL Twilio posts to. Set this in production so signature checks
# use the exact URL Twilio signed.
# PUBLIC_BASE_URL=https://virtual-companion-relay.onrender.com

# LLM triage. Leave unset to run keyword-only.
# ANTHROPIC_API_KEY=
# TRIAGE_MODEL=claude-haiku-5-5
# TRIAGE_TIMEOUT_MS=8000
# TRIAGE_PREFERENCES=Anything from my manager is urgent. Newsletters are noise.

PORT=3000
